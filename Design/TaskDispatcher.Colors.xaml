<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        TaskDispatcher 颜色资源（暗色主题）
        来源：taskdispatcher-prototype.html 设计稿 Token 提取
        格式：#AARRGGBB（ARGB）
        用法：App.xaml 中合并本字典后，通过 {StaticResource Brush.Xxx} 或 {StaticResource Color.Xxx} 引用
    -->

    <!-- ========== 主色 ========== -->
    <Color x:Key="Color.Primary">#FF007AFF</Color>            <!-- --primary 按钮/选中/链接基础色 -->
    <Color x:Key="Color.PrimaryHover">#FF3395FF</Color>       <!-- --primary-hover 按钮 hover -->
    <Color x:Key="Color.InfoBright">#FF4098FC</Color>         <!-- --blue-bright 暗底提亮：链接/选中导航/焦点 -->
    <Color x:Key="Color.InfoDim">#29007AFF</Color>            <!-- --blue-dim 选中导航背景（16% 主色） -->
    <Color x:Key="Color.FocusGlow">#33007AFF</Color>          <!-- 输入框聚焦光环（20% 主色） -->

    <!-- ========== 背景 / 卡片 ========== -->
    <Color x:Key="Color.WindowBackground">#FF17181C</Color>   <!-- --bg 窗体底色/输入框底色 -->
    <Color x:Key="Color.CardBackground">#FF222429</Color>     <!-- --card 卡片/标题栏/侧边栏 -->
    <Color x:Key="Color.CardBackgroundAlt">#FF2A2D34</Color>  <!-- --card-2 / --fill-2 弹窗底/次级填充 -->
    <Color x:Key="Color.ControlFill">#FF31343C</Color>        <!-- --fill-3 chips/开关底/hover 高亮 -->
    <Color x:Key="Color.ScrollbarThumb">#FF3A3E48</Color>     <!-- 滚动条滑块 -->

    <!-- ========== 边框 / 分割线 ========== -->
    <Color x:Key="Color.Border">#FF33363E</Color>             <!-- --border 输入框/卡片边框 -->
    <Color x:Key="Color.Divider">#FF2C2F36</Color>            <!-- --divider 表格行/卡内分割线 -->

    <!-- ========== 文字（四级） ========== -->
    <Color x:Key="Color.TextPrimary">#FFF2F3F5</Color>        <!-- --text-1 标题/任务名/主要文字 -->
    <Color x:Key="Color.TextSecondary">#FFA9AEB8</Color>      <!-- --text-2 正文/描述 -->
    <Color x:Key="Color.TextTertiary">#FF6E737D</Color>       <!-- --text-3 次要文字/表头/占位提示 -->
    <Color x:Key="Color.TextDisabled">#FF52565E</Color>       <!-- --text-4 禁用/最弱层级文字 -->

    <!-- ========== 语义色 ========== -->
    <Color x:Key="Color.Success">#FF2EC258</Color>            <!-- --green 成功/已启用/ADB 已连接 -->
    <Color x:Key="Color.SuccessDim">#242EC258</Color>         <!-- --green-dim 成功徽章背景（14%） -->
    <Color x:Key="Color.Danger">#FFF76560</Color>             <!-- --red 失败/删除/断开 -->
    <Color x:Key="Color.DangerDim">#80F76560</Color>          <!-- 危险按钮 hover 边框（50%） -->

    <!-- ========== 交互覆盖层 ========== -->
    <Color x:Key="Color.HoverOverlay">#0AFFFFFF</Color>       <!-- 表格行 hover（2.5% 白） -->
    <Color x:Key="Color.ControlHoverOverlay">#14FFFFFF</Color><!-- 标题栏窗口按钮 hover（8% 白） -->
    <Color x:Key="Color.DialogMask">#8C000000</Color>         <!-- 弹窗遮罩（55% 黑） -->
    <Color x:Key="Color.DropShadow">#66000000</Color>         <!-- 弹窗/窗体投影（40% 黑） -->
    <Color x:Key="Color.CloseButtonHover">#FFC42B1C</Color>   <!-- Windows 关闭按钮 hover 红 -->

    <!-- ========== 桌面背景渐变（可选：主窗口外层） ========== -->
    <Color x:Key="Color.DesktopGradient1">#FF0B0D12</Color>
    <Color x:Key="Color.DesktopGradient2">#FF131A28</Color>
    <Color x:Key="Color.DesktopGradient3">#FF1A2436</Color>
    <Color x:Key="Color.DesktopGradient4">#FF263650</Color>

    <!-- ========== 画刷（与上方颜色一一对应） ========== -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}"/>
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}"/>
    <SolidColorBrush x:Key="Brush.InfoBright" Color="{StaticResource Color.InfoBright}"/>
    <SolidColorBrush x:Key="Brush.InfoDim" Color="{StaticResource Color.InfoDim}"/>
    <SolidColorBrush x:Key="Brush.FocusGlow" Color="{StaticResource Color.FocusGlow}"/>

    <SolidColorBrush x:Key="Brush.WindowBackground" Color="{StaticResource Color.WindowBackground}"/>
    <SolidColorBrush x:Key="Brush.CardBackground" Color="{StaticResource Color.CardBackground}"/>
    <SolidColorBrush x:Key="Brush.CardBackgroundAlt" Color="{StaticResource Color.CardBackgroundAlt}"/>
    <SolidColorBrush x:Key="Brush.ControlFill" Color="{StaticResource Color.ControlFill}"/>
    <SolidColorBrush x:Key="Brush.ScrollbarThumb" Color="{StaticResource Color.ScrollbarThumb}"/>

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}"/>
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}"/>

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}"/>
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="{StaticResource Color.TextTertiary}"/>
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="{StaticResource Color.TextDisabled}"/>

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}"/>
    <SolidColorBrush x:Key="Brush.SuccessDim" Color="{StaticResource Color.SuccessDim}"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}"/>
    <SolidColorBrush x:Key="Brush.DangerDim" Color="{StaticResource Color.DangerDim}"/>

    <SolidColorBrush x:Key="Brush.HoverOverlay" Color="{StaticResource Color.HoverOverlay}"/>
    <SolidColorBrush x:Key="Brush.ControlHoverOverlay" Color="{StaticResource Color.ControlHoverOverlay}"/>
    <SolidColorBrush x:Key="Brush.DialogMask" Color="{StaticResource Color.DialogMask}"/>
    <SolidColorBrush x:Key="Brush.DropShadow" Color="{StaticResource Color.DropShadow}"/>
    <SolidColorBrush x:Key="Brush.CloseButtonHover" Color="{StaticResource Color.CloseButtonHover}"/>

    <LinearGradientBrush x:Key="Brush.DesktopBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource Color.DesktopGradient1}" Offset="0"/>
        <GradientStop Color="{StaticResource Color.DesktopGradient2}" Offset="0.4"/>
        <GradientStop Color="{StaticResource Color.DesktopGradient3}" Offset="0.7"/>
        <GradientStop Color="{StaticResource Color.DesktopGradient4}" Offset="1"/>
    </LinearGradientBrush>

</ResourceDictionary>
