<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ========== 主色 ==========  -->
    <Color x:Key="PrimaryColor">#FF007AFF</Color>
    <!--  primary 按钮/选中/链接基础色  -->
    <Color x:Key="PrimaryHoverColor">#FF3395FF</Color>
    <!--  primary-hover 按钮 hover  -->
    <Color x:Key="InfoBrightColor">#FF4098FC</Color>
    <!--  blue-bright 暗底提亮：链接/选中导航/焦点  -->
    <Color x:Key="InfoDimColor">#29007AFF</Color>
    <!--  blue-dim 选中导航背景（16% 主色）  -->
    <Color x:Key="FocusGlowColor">#33007AFF</Color>
    <!--  输入框聚焦光环（20% 主色）  -->

    <!--  ========== 背景 / 卡片 ==========  -->
    <Color x:Key="WindowBackgroundColor">#FF17181C</Color>
    <!--  bg 窗体底色/输入框底色  -->
    <Color x:Key="CardBackgroundColor">#FF222429</Color>
    <!--  card 卡片/标题栏/侧边栏  -->
    <Color x:Key="CardBackgroundAltColor">#FF2A2D34</Color>
    <!--  card-2 / fill-2 弹窗底/次级填充  -->
    <Color x:Key="ControlFillColor">#FF31343C</Color>
    <!--  fill-3 chips/开关底/hover 高亮  -->
    <Color x:Key="ScrollbarThumbColor">#FF3A3E48</Color>
    <!--  滚动条滑块  -->

    <!--  ========== 边框 / 分割线 ==========  -->
    <Color x:Key="BorderColor">#FF33363E</Color>
    <!--  border 输入框/卡片边框  -->
    <Color x:Key="DividerColor">#FF2C2F36</Color>
    <!--  divider 表格行/卡内分割线  -->

    <!--  ========== 文字（四级） ==========  -->
    <Color x:Key="TextPrimaryColor">#FFF2F3F5</Color>
    <!--  text-1 标题/任务名/主要文字  -->
    <Color x:Key="TextSecondaryColor">#FFA9AEB8</Color>
    <!--  text-2 正文/描述  -->
    <Color x:Key="TextTertiaryColor">#FF6E737D</Color>
    <!--  text-3 次要文字/表头/占位提示  -->
    <Color x:Key="TextDisabledColor">#FF52565E</Color>
    <!--  text-4 禁用/最弱层级文字  -->

    <!--  ========== 语义色 ==========  -->
    <Color x:Key="SuccessColor">#FF2EC258</Color>
    <!--  green 成功/已启用/ADB 已连接  -->
    <Color x:Key="SuccessDimColor">#242EC258</Color>
    <!--  green-dim 成功徽章背景（14%）  -->
    <Color x:Key="DangerColor">#FFF76560</Color>
    <!--  red 失败/删除/断开  -->
    <Color x:Key="DangerDimColor">#80F76560</Color>
    <!--  危险按钮 hover 边框（50%）  -->

    <!--  ========== 交互覆盖层 ==========  -->
    <Color x:Key="HoverOverlayColor">#0AFFFFFF</Color>
    <!--  表格行 hover（2.5% 白）  -->
    <Color x:Key="ControlHoverOverlayColor">#14FFFFFF</Color>
    <!--  标题栏窗口按钮 hover（8% 白）  -->
    <Color x:Key="DialogMaskColor">#8C000000</Color>
    <!--  弹窗遮罩（55% 黑）  -->
    <Color x:Key="DropShadowColor">#66000000</Color>
    <!--  弹窗/窗体投影（40% 黑）  -->
    <Color x:Key="CloseButtonHoverColor">#FFC42B1C</Color>
    <!--  Windows 关闭按钮 hover 红  -->

    <!--  ========== 桌面背景渐变（可选：主窗口外层） ==========  -->
    <Color x:Key="DesktopGradient1Color">#FF0B0D12</Color>
    <Color x:Key="DesktopGradient2Color">#FF131A28</Color>
    <Color x:Key="DesktopGradient3Color">#FF1A2436</Color>
    <Color x:Key="DesktopGradient4Color">#FF263650</Color>

    <!--  ========== 画刷（与上方颜色一一对应） ==========  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="InfoBrightBrush" Color="{StaticResource InfoBrightColor}" />
    <SolidColorBrush x:Key="InfoDimBrush" Color="{StaticResource InfoDimColor}" />
    <SolidColorBrush x:Key="FocusGlowBrush" Color="{StaticResource FocusGlowColor}" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundAltBrush" Color="{StaticResource CardBackgroundAltColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}" />

    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessDimBrush" Color="{StaticResource SuccessDimColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerDimBrush" Color="{StaticResource DangerDimColor}" />

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="ControlHoverOverlayBrush" Color="{StaticResource ControlHoverOverlayColor}" />
    <SolidColorBrush x:Key="DialogMaskBrush" Color="{StaticResource DialogMaskColor}" />
    <SolidColorBrush x:Key="DropShadowBrush" Color="{StaticResource DropShadowColor}" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="{StaticResource CloseButtonHoverColor}" />

    <LinearGradientBrush x:Key="DesktopBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource DesktopGradient1Color}" />
        <GradientStop Offset="0.4" Color="{StaticResource DesktopGradient2Color}" />
        <GradientStop Offset="0.7" Color="{StaticResource DesktopGradient3Color}" />
        <GradientStop Offset="1" Color="{StaticResource DesktopGradient4Color}" />
    </LinearGradientBrush>
</ResourceDictionary>
