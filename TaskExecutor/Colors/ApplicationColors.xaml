<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  ========== 主色 ==========  -->
    <Color x:Key="PrimaryColor">#FF007AFF</Color>
    <!--  primary 按钮/选中/链接基础色  -->
    <Color x:Key="PrimaryHoverColor">#FF3395FF</Color>
    <!--  primary-hover 按钮 hover  -->
    <Color x:Key="InfoBrightColor">#FF007AFF</Color>
    <!--  blue-bright 亮底下主蓝即提亮色：链接/选中导航/焦点  -->
    <Color x:Key="InfoDimColor">#1A007AFF</Color>
    <!--  blue-dim 选中导航背景（10% 主色）  -->
    <Color x:Key="FocusGlowColor">#33007AFF</Color>
    <!--  输入框聚焦光环（20% 主色）  -->

    <!--  ========== 背景 / 卡片 ==========  -->
    <Color x:Key="WindowBackgroundColor">#FFF5F6F8</Color>
    <!--  bg 窗体底色/输入框底色  -->
    <Color x:Key="CardBackgroundColor">#FFFFFFFF</Color>
    <!--  card 卡片/标题栏/侧边栏  -->
    <Color x:Key="CardBackgroundAltColor">#FFF7F8FA</Color>
    <!--  card-2 / fill-2 弹窗底/次级填充  -->
    <Color x:Key="ControlFillColor">#FFECEEF2</Color>
    <!--  fill-3 chips/开关底/hover 高亮  -->
    <Color x:Key="ScrollbarThumbColor">#FFC9CDD4</Color>
    <!--  滚动条滑块  -->

    <!--  ========== 边框 / 分割线 ==========  -->
    <Color x:Key="CardBorderColor">#FFD9DDE3</Color>
    <!--  border 输入框/卡片边框  -->
    <Color x:Key="DividerColor">#FFE8EAEE</Color>
    <!--  divider 表格行/卡内分割线  -->

    <!--  ========== 文字（四级） ==========  -->
    <Color x:Key="TextPrimaryColor">#FF1A1D21</Color>
    <!--  text-1 标题/任务名/主要文字  -->
    <Color x:Key="TextSecondaryColor">#FF4E535C</Color>
    <!--  text-2 正文/描述  -->
    <Color x:Key="TextTertiaryColor">#FF8A8F99</Color>
    <!--  text-3 次要文字/表头/占位提示  -->
    <Color x:Key="TextDisabledColor">#FFB4B8C0</Color>
    <!--  text-4 禁用/最弱层级文字  -->

    <!--  ========== 语义色 ==========  -->
    <Color x:Key="SuccessColor">#FF1FA84F</Color>
    <!--  green 成功/已启用/ADB 已连接（亮底下加深保证对比度）  -->
    <Color x:Key="SuccessDimColor">#1F1FA84F</Color>
    <Color x:Key="WarningColor">#FFF5A500</Color>
    <!--  yellow 警告/待处理  -->
    <Color x:Key="WarningDimColor">#24F5A500</Color>
    <!--  yellow-dim 警告徽章背景（14%）  -->
    <Color x:Key="DangerColor">#FFE5484D</Color>
    <!--  red 失败/删除/断开  -->
    <Color x:Key="DangerDimColor">#80E5484D</Color>
    <!--  危险按钮 hover 边框（50%）  -->

    <!--  ========== 交互覆盖层 ==========  -->
    <Color x:Key="HoverOverlayColor">#08000000</Color>
    <!--  表格行 hover（3% 黑）  -->
    <Color x:Key="ControlHoverOverlayColor">#14000000</Color>
    <!--  标题栏窗口按钮 hover（8% 黑）  -->
    <Color x:Key="DialogMaskColor">#66000000</Color>
    <!--  弹窗遮罩（40% 黑）  -->
    <Color x:Key="DropShadowColor">#33000000</Color>
    <!--  弹窗/窗体投影（20% 黑）  -->
    <Color x:Key="CloseButtonHoverColor">#FFC42B1C</Color>
    <!--  Windows 关闭按钮 hover 红  -->

    <!--  ========== 桌面背景渐变（可选：主窗口外层） ==========  -->
    <Color x:Key="DesktopGradient1Color">#FFEDEFF2</Color>
    <Color x:Key="DesktopGradient2Color">#FFE8EBF0</Color>
    <Color x:Key="DesktopGradient3Color">#FFE3E8EF</Color>
    <Color x:Key="DesktopGradient4Color">#FFDDE4EE</Color>

    <!--  ========== 画刷（与上方颜色一一对应） ==========  -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="InfoBrightBrush" Color="{StaticResource InfoBrightColor}" />
    <SolidColorBrush x:Key="InfoDimBrush" Color="{StaticResource InfoDimColor}" />
    <SolidColorBrush x:Key="FocusGlowBrush" Color="{StaticResource FocusGlowColor}" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource CardBackgroundColor}" />
    <SolidColorBrush x:Key="CardBackgroundAltBrush" Color="{StaticResource CardBackgroundAltColor}" />
    <SolidColorBrush x:Key="ControlFillBrush" Color="{StaticResource ControlFillColor}" />
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="{StaticResource ScrollbarThumbColor}" />

    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{StaticResource TextTertiaryColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />

    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="SuccessDimBrush" Color="{StaticResource SuccessDimColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="WarningDimBrush" Color="{StaticResource WarningDimColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="DangerDimBrush" Color="{StaticResource DangerDimColor}" />

    <SolidColorBrush x:Key="HoverOverlayBrush" Color="{StaticResource HoverOverlayColor}" />
    <SolidColorBrush x:Key="ControlHoverOverlayBrush" Color="{StaticResource ControlHoverOverlayColor}" />
    <SolidColorBrush x:Key="DialogMaskBrush" Color="{StaticResource DialogMaskColor}" />
    <SolidColorBrush x:Key="DropShadowBrush" Color="{StaticResource DropShadowColor}" />
    <SolidColorBrush x:Key="CloseButtonHoverBrush" Color="{StaticResource CloseButtonHoverColor}" />

    <LinearGradientBrush x:Key="DesktopBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="{StaticResource DesktopGradient1Color}" />
        <GradientStop Offset="0.4" Color="{StaticResource DesktopGradient2Color}" />
        <GradientStop Offset="0.7" Color="{StaticResource DesktopGradient3Color}" />
        <GradientStop Offset="1" Color="{StaticResource DesktopGradient4Color}" />
    </LinearGradientBrush>
</ResourceDictionary>
