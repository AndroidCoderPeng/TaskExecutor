<UserControl
    x:Class="TaskExecutor.Views.RecordArchiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cvt="clr-namespace:TaskExecutor.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    xmlns:enums="clr-namespace:TaskExecutor.Enums"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:model="clr-namespace:TaskExecutor.Model"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:RecordArchiveViewModel}"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Row="0"
            Background="{StaticResource CardBackgroundBrush}"
            LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="记录归档" />

            <TextBlock
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="任务截图归档" />
        </DockPanel>

        <TextBlock
            Grid.Row="1"
            Margin="20,16"
            Foreground="{StaticResource TextTertiaryBrush}"
            Text="「截屏」动作的图片归档：文件名即生成时间（ScreenCapture_20261114_153012.png），按天分组展示，点击缩略图放大查看；截图随任务执行持续增长，请定期清理。" />

        <Grid Grid.Row="2" Margin="20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CommonBorderStyle}">
                <StackPanel Margin="16,16,16,12" Orientation="Vertical">
                    <TextBlock Foreground="{StaticResource TextTertiaryBrush}" Text="截图总数" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,8,0,0"
                            FontFamily="Consolas"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{Binding ImageTotalCount}" />
                        <TextBlock
                            Margin="8,0,4,6"
                            VerticalAlignment="Bottom"
                            Text="张" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CommonBorderStyle}">
                <StackPanel Margin="16,16,16,12" Orientation="Vertical">
                    <TextBlock Foreground="{StaticResource TextTertiaryBrush}" Text="今日新增" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,8,0,0"
                            FontFamily="Consolas"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="{Binding NewImageCount}" />
                        <TextBlock
                            Margin="8,0,4,6"
                            VerticalAlignment="Bottom"
                            Foreground="{StaticResource PrimaryBrush}"
                            Text="张" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource CommonBorderStyle}">
                <StackPanel Margin="16,16,16,12" Orientation="Vertical">
                    <TextBlock Foreground="{StaticResource TextTertiaryBrush}" Text="占用空间" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,8,0,0"
                            FontFamily="Consolas"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{Binding TotalSize}" />
                        <TextBlock
                            Margin="8,0,4,6"
                            VerticalAlignment="Bottom"
                            Text="KB" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource CommonBorderStyle}">
                <StackPanel Margin="16,16,16,12" Orientation="Vertical">
                    <TextBlock Foreground="{StaticResource TextTertiaryBrush}" Text="最近截屏" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,8,6"
                            VerticalAlignment="Bottom"
                            Text="{Binding LastCaptureDay}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            FontFamily="Consolas"
                            FontSize="30"
                            FontWeight="SemiBold"
                            Text="{Binding LastCaptureTime}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <Border
            Grid.Row="3"
            Margin="20,12"
            Style="{StaticResource CommonBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <TextBlock
                        Margin="16,12,8,12"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="当前连接" />

                    <Border
                        Padding="8,3"
                        VerticalAlignment="Center"
                        Background="{StaticResource ControlFillBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="{Binding DayGroups.Count, StringFormat={}{0} 张, FallbackValue=0 张}" />
                    </Border>
                </StackPanel>

                <ListBox
                    Grid.Row="1"
                    Margin="12,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding DayGroups}">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="8,8,0,8" LastChildFill="True">
                                        <TextBlock
                                            d:DataContext="{d:DesignInstance Type=data:CollectionViewGroup}"
                                            FontWeight="SemiBold"
                                            Foreground="{StaticResource TextDisabledBrush}"
                                            Text="{Binding Name}" />

                                        <Grid
                                            Height="0.25"
                                            Margin="8,0,0,0"
                                            Background="{StaticResource TextDisabledBrush}" />
                                    </DockPanel>
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
