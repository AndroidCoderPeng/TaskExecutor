<UserControl
    x:Class="TaskExecutor.Views.WxConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:WxConfigViewModel}"
    mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <DockPanel Background="{StaticResource CardBackgroundBrush}" LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="企业微信配置" />

            <TextBlock
                Margin="20,16"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="群机器人 Webhook" />
        </DockPanel>

        <Border
            Height="256"
            Margin="20,16"
            Style="{StaticResource CommonBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="16,12,10,12"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="企业微信群机器人" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="Webhook 推送" />
                </Grid>

                <Grid Grid.Row="1" Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Grid Width="110">
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="Webhook Key" />
                        </Grid>

                        <TextBox Margin="12,0,0,0" Style="{StaticResource FieldTextBoxStyle}" />
                    </DockPanel>

                    <DockPanel
                        Grid.Row="1"
                        Margin="0,16"
                        LastChildFill="True">
                        <Grid Width="110">
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="消息标题" />
                        </Grid>

                        <TextBox Margin="12,0,0,0" Style="{StaticResource FieldTextBoxStyle}" />
                    </DockPanel>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Grid Width="110">
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="附带截屏" />
                        </Grid>

                        <CheckBox
                            Margin="12,0,0,0"
                            Content="开启后任务截文件以图片消息发送"
                            Foreground="{StaticResource TextTertiaryBrush}" />
                    </StackPanel>
                </Grid>

                <Border
                    Grid.Row="2"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="Key 在群机器人「设置 → Webhook 地址」中获取" />

                        <Button
                            Grid.Column="1"
                            Content="测试企业微信通知"
                            Style="{StaticResource CommonButtonStyle}" />

                        <Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Padding="14,0"
                            Content="保存配置"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
