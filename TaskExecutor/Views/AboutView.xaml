<UserControl
    x:Class="TaskExecutor.Views.AboutView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:AboutViewModel}"
    mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <DockPanel Background="{StaticResource CardBackgroundBrush}" LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="关于应用" />

            <TextBlock
                Margin="20,16"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="项目与版本信息" />
        </DockPanel>

        <!--  内容区  -->
        <Border Margin="20,16" Style="{StaticResource CommonBorderStyle}">
            <StackPanel
                Margin="0,32,0,24"
                HorizontalAlignment="Center"
                Orientation="Vertical">

                <!--  应用图标  -->
                <Image
                    Width="52"
                    Height="52"
                    Source="/TaskExecutor;component/Images/application.png"
                    Stretch="Uniform" />

                <!--  应用名  -->
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="TaskExecutor" />

                <!--  版本行  -->
                <TextBlock
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="Version 2.0.0 · WPF · .NET 8（C# / MVVM）" />

                <!--  简介  -->
                <TextBlock
                    MaxWidth="440"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontSize="12"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    LineHeight="22"
                    LineStackingStrategy="BlockLineHeight"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    Windows 桌面端定时任务自动化工具：Wi-Fi ADB 无线控制 Android 设备，链<LineBreak />
                    式任务调度、随机时间偏移、邮件与企业微信通知。<LineBreak />
                    作者：PengXianHong · 遵循 GPL-3.0 协议开源发布</TextBlock>

                <!--  项目主页链接 chip（虚线边框）  -->
                <Grid Margin="0,10,0,0">
                    <Rectangle
                        Fill="{StaticResource WindowBackgroundBrush}"
                        RadiusX="8"
                        RadiusY="8"
                        Stroke="{StaticResource CardBorderBrush}"
                        StrokeDashArray="4 3"
                        StrokeThickness="1" />
                    <TextBlock
                        Margin="28,14"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{StaticResource TextDisabledBrush}"
                        Text="{Binding ProjectHomePage}" />
                </Grid>

                <!--  操作按钮  -->
                <StackPanel
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,8,0"
                        Padding="14,0"
                        Command="{Binding OpenHomePageCommand}"
                        Content="打开项目主页"
                        Style="{StaticResource PrimaryButtonStyle}" />

                    <Button
                        Margin="8,0,0,0"
                        Command="{Binding CopyLinkCommand}"
                        Content="复制链接"
                        Style="{StaticResource CommonButtonStyle}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
