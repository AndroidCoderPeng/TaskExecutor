<UserControl
    x:Class="TaskExecutor.Views.TaskScheduleView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:TaskScheduleViewModel}"
    mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <DockPanel Background="{StaticResource CardBackgroundBrush}" LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="调度开关" />

            <TextBlock
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="节假日 / 重置" />
        </DockPanel>

        <Border
            Height="128"
            Margin="20,16,20,12"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="16,12"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="调度开关" />

                <StackPanel
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Orientation="Vertical">
                    <StackPanel Margin="64,0,0,12" Orientation="Horizontal">
                        <Grid Width="80" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="跳过节假日" />
                        </Grid>

                        <CheckBox
                            Margin="12,0,0,0"
                            Content="法定节假日与周末自动跳过执行"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            IsChecked="{Binding IsSkipHoliday}"
                            Style="{StaticResource CheckBoxSwitchStyle}" />
                    </StackPanel>

                    <StackPanel Margin="64,0,0,0" Orientation="Horizontal">
                        <Grid Width="80" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="重置任务" />
                        </Grid>

                        <CheckBox
                            Margin="12,0,0,0"
                            Content="到达重置时间点后任务链重新开始"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            IsChecked="{Binding IsResetDailyTask}"
                            Style="{StaticResource CheckBoxSwitchStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Margin="20,0,20,12"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="16,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="自定义工作日" />

                    <TextBlock
                        Grid.Column="1"
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="按星期循环生效，如勾选周六，则每周六都会执行任务" />

                    <Button
                        Grid.Column="2"
                        Command="{Binding ResetWorkdayCommand}"
                        Content="恢复默认"
                        Style="{StaticResource TextButtonStyle}" />
                </Grid>

                <ListBox
                    Grid.Row="1"
                    Margin="16,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Weekdays}"
                    ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton
                                Padding="12"
                                Content="{Binding Name}"
                                IsChecked="{Binding IsChecked}">
                                <ToggleButton.Style>
                                    <Style BasedOn="{StaticResource ToggleButtonStyle}" TargetType="ToggleButton">
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="6,0" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <TextBlock
                    Grid.Row="2"
                    Margin="16,12"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="勾选的星期当天任务正常调度，未勾选视为休息日（配合「跳过节假日」开关生效）；全部取消则每天都跳过" />
            </Grid>
        </Border>

        <Border
            Height="150"
            Margin="20,0"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="16,12"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        Text="节假日数据" />

                    <TextBlock
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="数据源：chinese-days" />
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="64,10,0,0">
                    <Run
                        FontSize="14"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="上次同步" />
                    <Run Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding LastSyncTime}" />
                    <Run Foreground="{StaticResource TextTertiaryBrush}" Text="· 覆盖" />
                    <Run Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding CurrentYear}" />
                    <Run Foreground="{StaticResource TextTertiaryBrush}" Text="全年" />
                </TextBlock>

                <Border
                    Grid.Row="2"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <DockPanel Margin="16,0" LastChildFill="False">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="建议每周同步一次，保证节假日判断准确" />

                        <Button
                            Margin="0,12"
                            Padding="14,0"
                            Command="{Binding SyncHolidayDataCommand}"
                            Content="同步节假日数据"
                            DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
