<UserControl
    x:Class="TaskExecutor.Views.FaqView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    d:DataContext="{d:DesignInstance Type=vm:FaqViewModel}"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel
            Grid.Row="0"
            Background="{StaticResource CardBackgroundBrush}"
            LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="常见问题" />

            <TextBlock
                Margin="20,16"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="无线连接 · MIUI / HyperOS 限制" />
        </DockPanel>

        <Border
            Grid.Row="1"
            Margin="20,16"
            Style="{StaticResource CommonBorderStyle}">
            <Grid>
                <wv2:WebView2 x:Name="FaqWebView" />

                <ProgressBar
                    x:Name="LoadingBar"
                    Height="3"
                    VerticalAlignment="Top"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="{StaticResource PrimaryBrush}"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />

                <TextBlock
                    x:Name="FallbackText"
                    Margin="24"
                    FontSize="13"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="未检测到 WebView2 运行时，无法渲染富文本 FAQ。请安装 Microsoft Edge WebView2 Runtime 后重试。"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
