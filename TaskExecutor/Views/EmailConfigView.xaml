<UserControl
    x:Class="TaskExecutor.Views.EmailConfigView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:EmailConfigViewModel}"
    mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <DockPanel Background="{StaticResource CardBackgroundBrush}" LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="邮箱配置" />

            <TextBlock
                Margin="20,16"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="QQ 邮箱 · SMTP" />
        </DockPanel>

        <Border
            Height="374"
            Margin="20,16"
            Style="{StaticResource CommonBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        Grid.Column="0"
                        Margin="16,12,10,12"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="邮箱（SMTP）" />

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="QQ 邮箱 · SSL 加密" />
                </Grid>

                <Grid Grid.Row="1" Margin="16,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="True">
                        <Grid Width="110">
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="STMP 服务器" />
                        </Grid>

                        <TextBox Margin="12,0,0,0" Style="{StaticResource FieldTextBoxStyle}" />
                    </DockPanel>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,16"
                        Orientation="Horizontal">
                        <Grid Width="110">
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="端口" />
                        </Grid>

                        <TextBox
                            Width="120"
                            Margin="12,0"
                            Style="{StaticResource FieldTextBoxStyle}" />

                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="SSL 加密连接（超时 60s）" />
                    </StackPanel>

                    <DockPanel Grid.Row="2" LastChildFill="True">
                        <Grid Width="110">
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="发件人邮箱" />
                        </Grid>

                        <TextBox Margin="12,0,0,0" Style="{StaticResource FieldTextBoxStyle}" />
                    </DockPanel>

                    <DockPanel
                        Grid.Row="3"
                        Margin="0,16"
                        LastChildFill="True">
                        <Grid Width="110">
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="授权码" />
                        </Grid>

                        <TextBox Margin="12,0,0,0" Style="{StaticResource FieldTextBoxStyle}" />
                    </DockPanel>

                    <DockPanel Grid.Row="4" LastChildFill="True">
                        <Grid Width="110">
                            <TextBlock
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="收件人邮箱" />
                        </Grid>

                        <TextBox Margin="12,0,0,0" Style="{StaticResource FieldTextBoxStyle}" />
                    </DockPanel>
                </Grid>

                <Border
                    Grid.Row="2"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <Grid Margin="16,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="授权码在 QQ 邮箱「设备 → 账户 → POP3/SMTP服务」中生成" />

                        <Button
                            Grid.Column="1"
                            Content="测试邮箱通知"
                            Style="{StaticResource CommonButtonStyle}" />

                        <Button
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Padding="14,0"
                            Content="保存配置"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
