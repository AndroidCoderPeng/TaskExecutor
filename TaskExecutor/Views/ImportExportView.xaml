<UserControl
    x:Class="TaskExecutor.Views.ImportExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ImportExportViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style
            x:Key="DataFileBorderStyle"
            BasedOn="{StaticResource CommonBorderStyle}"
            TargetType="Border">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FileHintStyle" TargetType="ContentControl">
            <Setter Property="Padding" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Rectangle
                                Fill="{StaticResource WindowBackgroundBrush}"
                                RadiusX="4"
                                RadiusY="4"
                                SnapsToDevicePixels="True"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeDashArray="3,3"
                                StrokeThickness="1" />
                            <TextBlock
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <DockPanel Background="{StaticResource CardBackgroundBrush}" LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{StaticResource TextPrimaryBrush}"
                Text="数据导入导出" />

            <TextBlock
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="配置备份与恢复" />
        </DockPanel>

        <TextBlock
            Margin="20,16"
            Foreground="{StaticResource TextTertiaryBrush}"
            Text="全部数据打包为一个 JSON 备份文件：定时任务、包名映射、通知与调度配置。恢复时自动识别内容，同名任务将被覆盖。" />

        <UniformGrid
            Height="168"
            Margin="20,0"
            Columns="2"
            Rows="1">
            <Border Margin="0,0,6,0" Style="{StaticResource DataFileBorderStyle}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border
                            Padding="8"
                            Background="{StaticResource InfoDimBrush}"
                            CornerRadius="8">
                            <TextBlock
                                FontFamily="/TaskExecutor;component/Fonts/#iconfont"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="&#xe626;" />
                        </Border>

                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="导出备份" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="将任务、包名映射、通知与调度配置打包为一个 JSON 文件，用于备份或迁移到其他电脑。授权码、Webhook Key 等敏感信息不会导出。"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="{Binding ExportFileName}"
                            Style="{StaticResource FileHintStyle}" />

                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="14,0"
                            Command="{Binding ExportConfigCommand}"
                            Content="导出备份"
                            FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Margin="6,0,0,0" Style="{StaticResource DataFileBorderStyle}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border
                            Padding="8"
                            Background="{StaticResource InfoDimBrush}"
                            CornerRadius="8">
                            <TextBlock
                                FontFamily="/TaskExecutor;component/Fonts/#iconfont"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource PrimaryBrush}"
                                Text="&#xe627;" />
                        </Border>

                        <TextBlock
                            Margin="12,0"
                            VerticalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            Text="导入备份" />
                    </StackPanel>

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="选择或拖入备份文件，自动识别内容并恢复，无需区分类型，识别到该格式时按包名映射导入。"
                        TextWrapping="Wrap" />

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Content="{Binding SelectedFilePath, FallbackValue=点击选择或拖入备份文件}"
                            Style="{StaticResource FileHintStyle}" />

                        <Button
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            Padding="14,0"
                            Command="{Binding ImportConfigCommand}"
                            Content="导入任务"
                            FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </Grid>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
