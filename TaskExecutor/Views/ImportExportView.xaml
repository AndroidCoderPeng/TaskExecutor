<UserControl
    x:Class="TaskExecutor.Views.ImportExportView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ImportExportViewModel}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="FileHintStyle" TargetType="ContentControl">
            <Setter Property="Padding" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContentControl">
                        <Grid>
                            <Rectangle
                                Fill="{StaticResource WindowBackgroundBrush}"
                                RadiusX="4"
                                RadiusY="4"
                                SnapsToDevicePixels="True"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeDashArray="3,3"
                                StrokeThickness="1" />
                            <TextBlock
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                FontFamily="{TemplateBinding FontFamily}"
                                FontSize="{TemplateBinding FontSize}"
                                Foreground="{TemplateBinding Foreground}"
                                Text="{TemplateBinding Content}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical">
        <DockPanel Background="{StaticResource CardBackgroundBrush}" LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="数据导入导出" />

            <TextBlock
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="配置备份与恢复" />
        </DockPanel>

        <TextBlock
            Margin="20,16"
            Foreground="{StaticResource TextTertiaryBrush}"
            Text="任务配置、目标 APP 映射与通知配置可导出为 CSV 备份，也可以从 CSV 备份恢复，导入时同名任务将被覆盖" />

        <UniformGrid
            Height="196"
            Margin="20,0"
            Columns="2"
            Rows="1">
            <Border Margin="0,0,6,0" Style="{StaticResource CommonBorderStyle}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="导出配置" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="将当前全部任务（名称、执行时间、动作链、通知方式）导出为 CSV 文件，可用于备份或迁移到其他电脑"
                        TextWrapping="Wrap" />

                    <ContentControl
                        Grid.Row="2"
                        VerticalAlignment="Top"
                        Content="{Binding ExportFileName, FallbackValue=tasks_2026-10-24.csv}"
                        Style="{StaticResource FileHintStyle}" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="14,0"
                            Content="导出任务配置"
                            FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            Content="导出全部配置"
                            FontSize="14"
                            Style="{StaticResource CommonButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="6,0,0,0" Style="{StaticResource CommonBorderStyle}">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock
                        Grid.Row="0"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="导入配置" />

                    <TextBlock
                        Grid.Row="1"
                        Margin="0,12"
                        Foreground="{StaticResource TextTertiaryBrush}"
                        Text="从 CSV 文件导入任务与包名映射。支持 TaskExecutor 导出格式，也支持自定义「应用名，包名」两列格式"
                        TextWrapping="Wrap" />

                    <ContentControl
                        Grid.Row="2"
                        VerticalAlignment="Top"
                        Content="{Binding SelectedFilePath, TargetNullValue=选择 CSV 文件…, FallbackValue=选择 CSV 文件…}"
                        Style="{StaticResource FileHintStyle}" />

                    <StackPanel Grid.Row="3" Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="14,0"
                            Content="导入任务"
                            FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            Content="导出包名映射"
                            FontSize="14"
                            Style="{StaticResource CommonButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>
    </StackPanel>
</UserControl>
