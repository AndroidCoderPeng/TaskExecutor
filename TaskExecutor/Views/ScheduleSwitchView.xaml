<UserControl
    x:Class="TaskExecutor.Views.ScheduleSwitchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:ScheduleSwitchViewModel}"
    mc:Ignorable="d">
    <StackPanel Orientation="Vertical">
        <DockPanel Background="{StaticResource CardBackgroundBrush}" LastChildFill="True">
            <TextBlock
                Margin="20,16"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Text="调度开关" />

            <TextBlock
                Margin="20"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="随机任务 / 节假日 / 重置" />
        </DockPanel>

        <Border
            Height="168"
            Margin="20,16,20,12"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Margin="16,12"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Text="调度开关" />

                <StackPanel
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Orientation="Vertical">
                    <StackPanel Margin="64,0,0,0" Orientation="Horizontal">
                        <Grid Width="80" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="随机任务" />
                        </Grid>


                        <CheckBox
                            Margin="12,0,0,0"
                            Content="启用后执行时间按随机范围偏移"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            IsChecked="True"
                            Style="{StaticResource CheckBoxSwitchStyle}" />
                    </StackPanel>

                    <StackPanel Margin="64,12,0,12" Orientation="Horizontal">
                        <Grid Width="80" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="跳过节假日" />
                        </Grid>

                        <CheckBox
                            Margin="12,0,0,0"
                            Content="法定节假日与周末自动跳过执行"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            IsChecked="True"
                            Style="{StaticResource CheckBoxSwitchStyle}" />
                    </StackPanel>

                    <StackPanel Margin="64,0,0,0" Orientation="Horizontal">
                        <Grid Width="80" VerticalAlignment="Center">
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="重置任务" />
                        </Grid>

                        <CheckBox
                            Margin="12,0,0,0"
                            Content="到达重置时间点后任务链重新开始"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Style="{StaticResource CheckBoxSwitchStyle}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Border
            Height="150"
            Margin="20,0"
            Background="{StaticResource CardBackgroundBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="16,12"
                    Orientation="Horizontal">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="White"
                        Text="节假日数据" />

                    <TextBlock
                        Margin="12,0"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource TextTertiaryBrush}">
                        <Run Text="数据源：" />
                        <Run Text="{Binding DataSource, FallbackValue=chinese-days}" />
                        <Run Text="（HTTPS CDN）" />
                    </TextBlock>
                </StackPanel>

                <TextBlock Grid.Row="1" Margin="64,10,0,0">
                    <Run
                        FontSize="14"
                        Foreground="{StaticResource TextSecondaryBrush}"
                        Text="上次同步" />
                    <Run Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding LastSyncTime, FallbackValue=2026-10-27 06:00:00}" />
                    <Run Foreground="{StaticResource TextTertiaryBrush}" Text="· 覆盖" />
                    <Run Foreground="{StaticResource TextTertiaryBrush}" Text="{Binding CurrentYear, FallbackValue=2026}" />
                    <Run Foreground="{StaticResource TextTertiaryBrush}" Text="全年" />
                </TextBlock>

                <Border
                    Grid.Row="2"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="0,1,0,0">
                    <DockPanel Margin="16,0" LastChildFill="False">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="建议每周同步一次，保证节假日判断准确" />

                        <Button
                            Margin="0,10"
                            Padding="14,0"
                            Command="{Binding SyncHolidayDataCommand}"
                            Content="同步节假日数据"
                            DockPanel.Dock="Right"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
