<Application
    x:Class="TaskExecutor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="clr-namespace:TaskExecutor.Views"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Colors/ApplicationColors.xaml" />
                <ResourceDictionary Source="Styles/ApplicationStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:WiFiConnectionViewModel}">
                <views:WiFiConnectionView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:TaskManagerViewModel}">
                <views:TaskManagerView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:ImportExportViewModel}">
                <views:ImportExportView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:TargetAppViewModel}">
                <views:TargetAppView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:EmailConfigViewModel}">
                <views:EmailConfigView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:WxConfigViewModel}">
                <views:WxConfigView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:TaskWaitTimeViewModel}">
                <views:TaskWaitTimeView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:TaskResetTimeViewModel}">
                <views:TaskResetTimeView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:RandomTimeViewModel}">
                <views:RandomTimeView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:ScheduleSwitchViewModel}">
                <views:ScheduleSwitchView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:CommandTestViewModel}">
                <views:CommandTestView/>
            </DataTemplate>
            
            <DataTemplate DataType="{x:Type vm:FaqViewModel}">
                <views:FaqView/>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
