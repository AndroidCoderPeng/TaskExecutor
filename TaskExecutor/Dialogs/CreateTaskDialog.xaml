<Window
    x:Class="TaskExecutor.Dialogs.CreateTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    Title="新建任务"
    Width="476"
    Height="550"
    d:DataContext="{d:DesignInstance Type=vm:CreateTaskDialogViewModel}"
    Background="{StaticResource WindowBackgroundBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource ControlFillBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CustomComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <!--  外框：底色 / 边框 / 圆角  -->
                            <Border
                                x:Name="RootBorder"
                                Background="{StaticResource ControlFillBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                SnapsToDevicePixels="True" />

                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  选中项文本  -->
                                <ContentPresenter
                                    x:Name="ContentSite"
                                    Grid.Column="0"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    IsHitTestVisible="False"
                                    SnapsToDevicePixels="True" />

                                <!--  右侧箭头  -->
                                <Path
                                    x:Name="Arrow"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Data="M 0,0 L 5,5 L 10,0"
                                    Stroke="{StaticResource TextSecondaryBrush}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1" />
                            </Grid>

                            <!--  点击层：放在最上层捕获鼠标、驱动 IsDropDownOpen  -->
                            <ToggleButton
                                ClickMode="Press"
                                Focusable="False"
                                IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--  下拉浮层（POPUP 名称必须保留为 PART_Popup）  -->
                            <Popup
                                x:Name="PART_Popup"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsDropDownOpen}"
                                Placement="Bottom"
                                PopupAnimation="Slide">
                                <Border
                                    x:Name="DropDownBorder"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Padding="2"
                                    Background="White"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <ScrollViewer
                                        CanContentScroll="True"
                                        SnapsToDevicePixels="True"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--  hover：边框变主色  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                            </Trigger>

                            <!--  展开：箭头翻转  -->
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 0,5 L 5,0 L 10,5" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24" Orientation="Vertical">
        <Border
            Padding="12,8"
            CornerRadius="4"
            Style="{StaticResource CommonBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{StaticResource SuccessBrush}" />

                <TextBlock
                    Margin="8,0,4,0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="执行设备：" />

                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding DeviceName}" />

                <TextBlock
                    Margin="8,0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{Binding SystemVersion, StringFormat={}· Android {0}}" />
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,16,0,6"
            FontSize="14"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="任务名称" />

        <TextBox
            Style="{StaticResource PlaceHolderTextBoxStyle}"
            Tag="请输入任务名称"
            Text="{Binding TaskName}" />

        <TextBlock
            Margin="0,12,0,6"
            FontSize="14"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="执行时间" />

        <TextBox
            Style="{StaticResource PlaceHolderTextBoxStyle}"
            Tag="HH:MM"
            Text="{Binding TaskTime}" />

        <TextBlock
            Margin="0,12,0,6"
            FontSize="14"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="目标 APP" />

        <ComboBox
            ItemsSource="{Binding TargetApps}"
            SelectedItem="{Binding SelectedTargetApp}"
            Style="{StaticResource CustomComboBoxStyle}">
            <ComboBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" />
                        <TextBlock Text="{Binding PackageName, StringFormat={} · {0}}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>

        <Grid Margin="0,12,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                FontSize="14"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="随即偏移时间" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Foreground="{StaticResource PrimaryBrush}"
                Text="{Binding Tips}" />

            <CheckBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,-10,0"
                FontSize="14"
                IsChecked="{Binding IsRandomOffsetTime}"
                Style="{StaticResource CheckBoxSwitchStyle}" />
        </Grid>

        <TextBlock
            Margin="0,12,0,6"
            FontSize="14"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="通知方式" />

        <Grid>
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="邮件通知" />

            <CheckBox
                Margin="0,0,-10,0"
                HorizontalAlignment="Right"
                FontSize="14"
                IsChecked="{Binding IsNotifyByMail}"
                Style="{StaticResource CheckBoxSwitchStyle}" />
        </Grid>

        <Grid Margin="0,8,0,16">
            <TextBlock
                VerticalAlignment="Center"
                FontSize="14"
                Foreground="{StaticResource TextSecondaryBrush}"
                Text="企业微信通知" />

            <CheckBox
                Margin="0,0,-10,0"
                HorizontalAlignment="Right"
                FontSize="14"
                IsChecked="{Binding IsNotifyByWechat}"
                Style="{StaticResource CheckBoxSwitchStyle}" />
        </Grid>

        <Border
            Background="Transparent"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="0,1,0,0">
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="保存后立即生效，节假日自动跳过" />

                <Button
                    Grid.Column="1"
                    Margin="8,0"
                    Command="{Binding CancelDialogCommand}"
                    Content="取消"
                    Style="{StaticResource CommonButtonStyle}" />

                <Button
                    Grid.Column="2"
                    Padding="14,0"
                    Command="{Binding SaveTaskCommand}"
                    Content="保存任务"
                    Style="{StaticResource PrimaryButtonStyle}" />
            </Grid>
        </Border>
    </StackPanel>
</Window>
