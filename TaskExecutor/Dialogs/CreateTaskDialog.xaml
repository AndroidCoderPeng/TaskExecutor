<Window
    x:Class="TaskExecutor.Dialogs.CreateTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    Title="新建任务"
    Width="476"
    Height="536"
    d:DataContext="{d:DesignInstance Type=vm:CreateTaskDialogViewModel}"
    Background="{StaticResource WindowBackgroundBrush}"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <StackPanel Margin="24" Orientation="Vertical">
        <Border
            Padding="12,8"
            CornerRadius="4"
            Style="{StaticResource CommonBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{StaticResource SuccessBrush}" />

                <TextBlock
                    Margin="8,0,4,0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="执行设备：" />

                <TextBlock Foreground="White" Text="{Binding DeviceName}" />

                <TextBlock
                    Margin="8,0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="{Binding SystemVersion, StringFormat={}· Android {0}}" />
            </StackPanel>
        </Border>

        <TextBlock
            Margin="0,16,0,6"
            FontSize="14"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="任务名称" />

        <TextBox
            Style="{StaticResource PlaceHolderTextBoxStyle}"
            Tag="请输入任务名称"
            Text="{Binding TaskName}" />

        <TextBlock
            Margin="0,12,0,6"
            FontSize="14"
            Foreground="{StaticResource TextSecondaryBrush}"
            Text="执行时间" />
    </StackPanel>
</Window>
