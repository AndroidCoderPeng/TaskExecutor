<Window
    x:Class="TaskExecutor.Dialogs.TaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:TaskExecutor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    Title="{Binding Title}"
    Width="690"
    Height="722"
    d:DataContext="{d:DesignInstance Type=vm:TaskDialogViewModel}"
    Background="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <Border
            Margin="16"
            Padding="12,8"
            CornerRadius="4"
            Style="{StaticResource CommonBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{StaticResource SuccessBrush}" />

                <TextBlock
                    Margin="8,0,4,0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="执行设备：" />

                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding DeviceSummary}" />
            </StackPanel>
        </Border>

        <Separator Background="{StaticResource CardBorderBrush}" />

        <StackPanel Margin="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    Background="{StaticResource InfoDimBrush}"
                    CornerRadius="2">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="01" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="任务配置" />

                <Separator Grid.Column="2" Background="{StaticResource CardBorderBrush}" />
            </Grid>

            <UniformGrid
                Margin="0,12"
                Columns="2"
                Rows="2">
                <Border
                    Margin="0,0,6,6"
                    Background="{StaticResource CardBackgroundAltBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Margin="12">
                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="任务名称" />

                        <TextBox
                            Margin="0,8,0,0"
                            Tag="请输入任务名称，名称创建后不可修改（可选）"
                            Text="{Binding TaskName}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource PlaceHolderTextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="IsReadOnly" Value="True" />
                                            <Setter Property="Cursor" Value="No" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Border>

                <Border
                    Margin="6,0,0,6"
                    Background="{StaticResource CardBackgroundAltBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Margin="12">
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="计划时间" />

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="随机偏移" />

                                <CheckBox
                                    Margin="8,0,-10,0"
                                    IsChecked="{Binding IsRandomOffsetTime}"
                                    Style="{StaticResource CheckBoxSwitchStyle}" />
                            </StackPanel>
                        </DockPanel>

                        <ctrl:TimePicker
                            Margin="0,2,0,0"
                            VerticalAlignment="Center"
                            Background="White"
                            MinuteStep="1"
                            TimeText="{Binding PlannedTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                        <TextBlock Margin="0,8,0,0" Foreground="{StaticResource PrimaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="不做随机偏移，到点立即执行" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsRandomOffsetTime}" Value="True">
                                            <Setter Property="Text" Value="{Binding Tips}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border
                    Margin="0,6,6,0"
                    Background="{StaticResource CardBackgroundAltBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Margin="12">
                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="目标 APP" />

                        <ComboBox
                            Margin="0,8,0,0"
                            Background="White"
                            ItemsSource="{Binding TargetApps}"
                            SelectedItem="{Binding SelectedTargetApp}"
                            Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding PackageName, StringFormat={} · {0}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border
                    Margin="6,6,0,0"
                    Background="{StaticResource CardBackgroundAltBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Margin="12">
                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="通知方式" />

                        <DockPanel LastChildFill="True">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="邮件通知" />

                            <RadioButton
                                Margin="0,0,-10,8"
                                HorizontalAlignment="Right"
                                GroupName="NotifyMethod"
                                IsChecked="{Binding IsNotifyByMail}"
                                Style="{StaticResource RadioButtonSwitchStyle}" />
                        </DockPanel>

                        <DockPanel LastChildFill="True">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="企业微信通知" />

                            <RadioButton
                                Margin="0,0,-10,0"
                                HorizontalAlignment="Right"
                                GroupName="NotifyMethod"
                                IsChecked="{Binding IsNotifyByWechat}"
                                Style="{StaticResource RadioButtonSwitchStyle}" />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    Background="{StaticResource InfoDimBrush}"
                    CornerRadius="2">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="02" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="任务动作" />

                <Separator Grid.Column="2" Background="{StaticResource CardBorderBrush}" />

                <TextBlock
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource TextDisabledBrush}"
                    Text="拖入或点击添加 · 拖拽调整命令执行顺序" />
            </Grid>

            <Grid Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="12"
                    Background="{StaticResource WindowBackgroundBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{StaticResource TextTertiaryBrush}" Text="动作库" />

                        <ListBox
                            Margin="0,8,0,0"
                            ItemsSource="{Binding DefaultActions}"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="12"
                    Background="{StaticResource WindowBackgroundBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="执行序列" />

                            <Border
                                Grid.Column="1"
                                Margin="8,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{StaticResource ControlFillBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="{Binding SelectedActions.Count, StringFormat={}{0} 步, FallbackValue=0 步}" />
                            </Border>

                            <Button
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Command="{Binding ClearActionsCommand}"
                                Content="清空"
                                Style="{StaticResource TextButtonStyle}" />
                        </Grid>

                        <Separator Margin="0,8" Background="{StaticResource CardBorderBrush}" />

                        <ListBox
                            ItemsSource="{Binding SelectedActions}"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Background="{StaticResource WindowBackgroundBrush}"
                BorderThickness="0"
                CornerRadius="6"
                Style="{StaticResource CommonBorderStyle}">
                <TextBlock
                    Margin="8"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="从上到下依次执行，某一步失败会中止后续动作" />
            </Border>
        </StackPanel>

        <Separator Background="{StaticResource CardBorderBrush}" />

        <Grid Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="保存后立即生效，节假日自动跳过" />

            <Button
                Grid.Column="1"
                Margin="8,0"
                Command="{Binding CancelDialogCommand}"
                Content="取消"
                Style="{StaticResource CommonButtonStyle}" />

            <Button
                Grid.Column="2"
                Padding="14,0"
                Command="{Binding SaveTaskCommand}"
                Content="{Binding SaveButtonText}"
                Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </StackPanel>
</Window>
