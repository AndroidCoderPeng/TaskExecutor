<Window
    x:Class="TaskExecutor.Dialogs.TaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrl="clr-namespace:TaskExecutor.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    Title="{Binding Title}"
    Width="690"
    Height="718"
    d:DataContext="{d:DesignInstance Type=vm:TaskDialogViewModel}"
    Background="White"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="ToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0,8" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border
                                x:Name="ToggleButtonBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    RecognizesAccessKey="True" />
                            </Border>

                            <!--  右上角选中角标（20×20）  -->
                            <Grid
                                x:Name="CheckBadge"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Visibility="Collapsed">
                                <Path Data="M0,0 L12,0 A8,8 0 0 1 20,8 L20,20 A20,20 0 0 1 0,0 Z" Fill="{StaticResource PrimaryBrush}" />
                                <Path
                                    Data="M9,8.5 L12,11 L16.5,5.5"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2" />
                            </Grid>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <!--  选中：蓝边 + 浅蓝底 + 蓝字 + 显示角标  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleButtonBorder" Property="Background" Value="{StaticResource InfoDimBrush}" />
                                <Setter TargetName="ToggleButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                <Setter TargetName="CheckBadge" Property="Visibility" Value="Visible" />
                            </Trigger>

                            <!--  未选中时 hover：边框提前亮一下，暗示可点  -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="IsChecked" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ToggleButtonBorder" Property="BorderBrush" Value="{StaticResource PrimaryHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <StackPanel Orientation="Vertical">
        <Border
            Margin="16,12"
            Padding="12,8"
            CornerRadius="4"
            Style="{StaticResource CommonBorderStyle}">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    Width="8"
                    Height="8"
                    Fill="{StaticResource SuccessBrush}" />

                <TextBlock
                    Margin="8,0,4,0"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    Text="执行设备：" />

                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="{Binding DeviceSummary}" />
            </StackPanel>
        </Border>

        <Grid Margin="16,0,16,9">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    Background="{StaticResource InfoDimBrush}"
                    CornerRadius="2">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="01" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="任务配置" />

                <Separator Grid.Column="2" Background="{StaticResource CardBorderBrush}" />
            </Grid>

            <Grid Grid.Row="1" Margin="0,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="0,0,6,6"
                    Background="{StaticResource CardBackgroundAltBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Margin="12">
                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="任务名称" />

                        <TextBox
                            Margin="0,8,0,0"
                            Tag="请输入任务名称，名称创建后不可修改（可选）"
                            Text="{Binding TaskName}">
                            <TextBox.Style>
                                <Style BasedOn="{StaticResource PlaceHolderTextBoxStyle}" TargetType="TextBox">
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                            <Setter Property="IsReadOnly" Value="True" />
                                            <Setter Property="Cursor" Value="No" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="6,0,0,6"
                    Background="{StaticResource CardBackgroundAltBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Margin="12">
                        <DockPanel LastChildFill="True">
                            <TextBlock
                                FontSize="14"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                Text="计划时间" />

                            <TextBlock
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource PrimaryBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRandomOffsetTime}" Value="True">
                                                <Setter Property="Text" Value="{Binding Tips}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DockPanel>

                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <ctrl:TimePicker
                                VerticalAlignment="Center"
                                Background="White"
                                MinuteStep="1"
                                TimeText="{Binding PlannedTime, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="随机偏移" />

                                <CheckBox
                                    Margin="8,0,-10,0"
                                    IsChecked="{Binding IsRandomOffsetTime}"
                                    Style="{StaticResource CheckBoxSwitchStyle}" />
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="0,6,6,0"
                    Background="{StaticResource CardBackgroundAltBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Margin="12">
                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="目标 APP" />

                        <ComboBox
                            Margin="0,8,0,0"
                            Background="White"
                            ItemsSource="{Binding TargetApps}"
                            SelectedItem="{Binding SelectedTargetApp}"
                            Style="{StaticResource CustomComboBoxStyle}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding PackageName, StringFormat={} · {0}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="6,6,0,0"
                    Background="{StaticResource CardBackgroundAltBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Margin="12" Orientation="Vertical">
                        <TextBlock
                            FontSize="14"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            Text="通知方式" />

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <ToggleButton
                                Grid.Column="0"
                                Margin="0,0,6,0"
                                IsChecked="{Binding IsNotifyByWechat}"
                                Style="{StaticResource ToggleButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/TaskExecutor;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe6d5;" />

                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="企业微信" />
                                </StackPanel>
                            </ToggleButton>

                            <ToggleButton
                                Grid.Column="1"
                                Margin="6,0,0,0"
                                IsChecked="{Binding IsNotifyByMail}"
                                Style="{StaticResource ToggleButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontFamily="/TaskExecutor;component/Fonts/#iconfont"
                                        FontSize="18"
                                        Text="&#xe690;" />

                                    <TextBlock
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="13"
                                        Text="QQ 邮箱" />
                                </StackPanel>
                            </ToggleButton>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="4,2"
                    VerticalAlignment="Center"
                    Background="{StaticResource InfoDimBrush}"
                    CornerRadius="2">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource PrimaryBrush}"
                        Text="02" />
                </Border>

                <TextBlock
                    Grid.Column="1"
                    Margin="8,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource TextPrimaryBrush}"
                    Text="任务动作" />

                <Separator Grid.Column="2" Background="{StaticResource CardBorderBrush}" />

                <TextBlock
                    Grid.Column="3"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{StaticResource TextDisabledBrush}"
                    Text="拖入或点击添加 · 拖拽调整命令执行顺序" />
            </Grid>

            <Grid Grid.Row="3" Margin="0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="12"
                    Background="{StaticResource WindowBackgroundBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Orientation="Vertical">
                        <TextBlock Foreground="{StaticResource TextTertiaryBrush}" Text="动作库" />

                        <ListBox
                            Background="Transparent"
                            BorderThickness="0"
                            ItemsSource="{Binding DefaultActions}"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Background="{Binding DimColor}"
                                        CornerRadius="6"
                                        Style="{StaticResource CommonBorderStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                Grid.Column="0"
                                                BorderBrush="{Binding Color}"
                                                BorderThickness="4,0,0,0"
                                                CornerRadius="4" />

                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,6"
                                                Text="{Binding Name}" />

                                            <Button
                                                Grid.Column="2"
                                                Margin="0,0,6,0"
                                                Content="+"
                                                Style="{StaticResource TextButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>

                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,6,0,0" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="12"
                    Background="{StaticResource WindowBackgroundBrush}"
                    Style="{StaticResource CommonBorderStyle}">
                    <StackPanel Orientation="Vertical">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="执行序列" />

                            <Border
                                Grid.Column="1"
                                Margin="8,0"
                                Padding="8,3"
                                VerticalAlignment="Center"
                                Background="{StaticResource ControlFillBrush}"
                                CornerRadius="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{StaticResource TextTertiaryBrush}"
                                    Text="{Binding SelectedActions.Count, StringFormat={}{0} 步, FallbackValue=0 步}" />
                            </Border>

                            <Button
                                Grid.Column="2"
                                Command="{Binding ClearActionsCommand}"
                                Content="清空"
                                Style="{StaticResource TextButtonStyle}" />
                        </Grid>

                        <Separator Margin="0,8" Background="{StaticResource CardBorderBrush}" />

                        <ListBox
                            ItemsSource="{Binding SelectedActions}"
                            ScrollViewer.CanContentScroll="False"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border
                Grid.Row="4"
                Background="{StaticResource WindowBackgroundBrush}"
                BorderThickness="0"
                CornerRadius="6"
                Style="{StaticResource CommonBorderStyle}">
                <TextBlock
                    Margin="8"
                    Foreground="{StaticResource TextTertiaryBrush}"
                    Text="从上到下依次执行，某一步失败会中止后续动作" />
            </Border>
        </Grid>

        <Separator Background="{StaticResource CardBorderBrush}" />

        <Grid Margin="16,9,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Foreground="{StaticResource TextTertiaryBrush}"
                Text="保存后立即生效，节假日自动跳过" />

            <Button
                Grid.Column="1"
                Margin="8,0"
                Command="{Binding CancelDialogCommand}"
                Content="取消"
                Style="{StaticResource CommonButtonStyle}" />

            <Button
                Grid.Column="2"
                Padding="14,0"
                Command="{Binding SaveTaskCommand}"
                Content="{Binding SaveButtonText}"
                Style="{StaticResource PrimaryButtonStyle}" />
        </Grid>
    </StackPanel>
</Window>
