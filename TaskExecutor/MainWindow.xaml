<Window
    x:Class="TaskExecutor.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:data="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:TaskExecutor.ViewModels"
    Title="TaskExecutor - 定时任务自动化"
    Width="1200"
    Height="806"
    d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
    Background="{StaticResource WindowBackgroundBrush}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <CollectionViewSource x:Key="MenuItemsView" Source="{Binding MenuItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Width="218">
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ListBox
                    x:Name="MenuListBox"
                    Grid.Row="0"
                    Padding="8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Source={StaticResource MenuItemsView}}"
                    SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                    SelectionMode="Single">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Margin="16,16,16,8"
                                        d:DataContext="{d:DesignInstance Type=data:CollectionViewGroup}"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextTertiaryBrush}"
                                        Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="MenuItemBorder"
                                Padding="4,0"
                                CornerRadius="4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        x:Name="IconTextBlock"
                                        Grid.Column="0"
                                        Margin="8"
                                        VerticalAlignment="Center"
                                        FontFamily="/TaskExecutor;component/Fonts/#iconfont"
                                        FontSize="16"
                                        Text="{Binding Icon}" />

                                    <TextBlock
                                        x:Name="TitleTextBlock"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="{Binding Title}" />
                                </Grid>
                            </Border>

                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource ControlHoverOverlayBrush}" />
                                </DataTrigger>

                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="MenuItemBorder" Property="Background" Value="{StaticResource FocusGlowBrush}" />
                                    <Setter TargetName="IconTextBlock" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                    <Setter TargetName="TitleTextBlock" Property="Foreground" Value="{StaticResource PrimaryBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,0,2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <b:Interaction.Triggers>
                        <b:EventTrigger EventName="SelectionChanged">
                            <b:InvokeCommandAction Command="{Binding MenuItemSelectedCommand}" CommandParameter="{Binding ElementName=MenuListBox, Path=SelectedItem}" />
                        </b:EventTrigger>
                    </b:Interaction.Triggers>
                </ListBox>

                <Border
                    Grid.Row="1"
                    Margin="12"
                    Background="{StaticResource CardBackgroundBrush}"
                    CornerRadius="6">
                    <StackPanel Margin="10" Orientation="Vertical">
                        <DockPanel>
                            <Ellipse
                                Width="10"
                                Height="10"
                                Fill="{StaticResource TextTertiaryBrush}" />

                            <TextBlock
                                Margin="8,0,0,0"
                                Foreground="{StaticResource TextTertiaryBrush}"
                                Text="{Binding DeviceState, FallbackValue=设备未连接}" />
                        </DockPanel>

                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{StaticResource TextTertiaryBrush}"
                            Text="{Binding DeviceName, FallbackValue=Pixel 6 · 192.168.1.100:5555}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  内容区  -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" />
    </DockPanel>
</Window>
